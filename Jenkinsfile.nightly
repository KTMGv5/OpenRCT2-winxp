pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
    }

    triggers {
        // Poll for new upstream OpenRCT2 commits every 30 minutes
        cron('H/30 * * * *')
    }

    parameters {
        string(
            name: 'OPENRCT2_BRANCH',
            defaultValue: 'develop',
            description: 'Upstream git branch for nightly development builds'
        )
        choice(
            name: 'BUILD_TYPE',
            choices: ['Release', 'Debug'],
            description: 'CMake build type'
        )
        booleanParam(
            name: 'FORCE_BUILD',
            defaultValue: false,
            description: 'Build even if no new upstream commits were pushed'
        )
        booleanParam(
            name: 'REUSE_BUILD_CACHE',
            defaultValue: true,
            description: 'Reuse precompiled dependency libraries from /home/tyler/OpenRCT2-XP/build'
        )
        booleanParam(
            name: 'PUBLISH_TO_GITHUB',
            defaultValue: true,
            description: 'Automatically publish the nightly zip to GitHub Releases as a pre-release'
        )
        string(
            name: 'GITHUB_REPO',
            defaultValue: 'KTMGv5/OpenRCT2-winxp',
            description: 'Target GitHub repository (owner/repo)'
        )
    }

    environment {
        BRANCH       = "${params.OPENRCT2_BRANCH}"
        BUILD_TYPE   = "${params.BUILD_TYPE}"
        GITHUB_REPO  = "${params.GITHUB_REPO}"
        NUM_CORES    = sh(script: 'nproc 2>/dev/null || echo 4', returnStdout: true).trim()
        BUILD_DATE   = sh(script: 'date +%Y%m%d', returnStdout: true).trim()
    }

    stages {
        stage('Toolchain Check') {
            steps {
                echo "=== Verifying Build Toolchain for Nightly Build ==="
                sh '''
                    i686-w64-mingw32-gcc --version | head -n 1
                    i686-w64-mingw32-g++ --version | head -n 1
                    cmake --version | head -n 1
                    python3 --version
                    which patch wget pkgconf
                '''
            }
        }

        stage('Check Upstream for New Commits') {
            steps {
                script {
                    echo "Checking upstream OpenRCT2 on branch '${BRANCH}'..."
                    def sha = sh(
                        script: "git ls-remote https://github.com/OpenRCT2/OpenRCT2.git refs/heads/${BRANCH} | awk '{print \$1}'",
                        returnStdout: true
                    ).trim()

                    if (!sha) {
                        error("Could not fetch remote commit SHA for branch ${BRANCH}")
                    }

                    def shortSha = sha.take(7)
                    env.UPSTREAM_SHA = sha
                    env.SHORT_SHA = shortSha

                    def lastBuiltSha = ""
                    if (fileExists(".last_built_develop_sha")) {
                        lastBuiltSha = readFile(".last_built_develop_sha").trim()
                    }

                    echo "Latest upstream commit: ${sha} (${shortSha})"
                    echo "Last built commit:       ${lastBuiltSha}"

                    // Check if GitHub Releases already contains a release for this commit
                    def alreadyPublished = false
                    try {
                        withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                            def releaseCheck = sh(
                                script: "gh release list --repo ${GITHUB_REPO} --limit 30 | grep -q '${shortSha}'",
                                returnStatus: true
                            )
                            if (releaseCheck == 0) {
                                alreadyPublished = true
                            }
                        }
                    } catch (Exception ignored) {}

                    if ((sha == lastBuiltSha || alreadyPublished) && !params.FORCE_BUILD) {
                        echo "=================================================="
                        echo "Upstream OpenRCT2 has no new commits since last build."
                        echo "Commit ${shortSha} is already built and published."
                        echo "Skipping build (use FORCE_BUILD=true to override)."
                        echo "=================================================="
                        env.SKIP_BUILD = "true"
                        currentBuild.displayName = "#${BUILD_NUMBER} - ${shortSha} (skipped: up-to-date)"
                        currentBuild.description = "Upstream ${BRANCH} commit ${shortSha} is already built"
                    } else {
                        env.SKIP_BUILD = "false"
                        env.NIGHTLY_PACKAGE = "OpenRCT2-winxp-nightly-${BUILD_DATE}-${shortSha}.zip"
                        currentBuild.displayName = "#${BUILD_NUMBER} - ${BRANCH} (${shortSha})"
                        currentBuild.description = "Upstream commit ${sha} built on ${BUILD_DATE}"
                        echo "New upstream commits detected! Proceeding to build ${shortSha}..."
                    }
                }
            }
        }

        stage('Prepare Workspace & Cache') {
            when {
                expression { return env.SKIP_BUILD != "true" }
            }
            steps {
                script {
                    sh '''
                        if [ "${REUSE_BUILD_CACHE}" = "true" ] && [ ! -d "build" ]; then
                            if [ -d "/home/tyler/OpenRCT2-XP/build" ]; then
                                echo "Populating dependency cache from /home/tyler/OpenRCT2-XP/build..."
                                cp -r /home/tyler/OpenRCT2-XP/build .
                                [ -f "/home/tyler/OpenRCT2-XP/i686-w64-mingw32-pkg-config" ] && cp /home/tyler/OpenRCT2-XP/i686-w64-mingw32-pkg-config .
                                echo "Cache copied successfully."
                            fi
                        fi
                    '''
                }
            }
        }

        stage('Verify & Auto-Patch Upstream') {
            when {
                expression { return env.SKIP_BUILD != "true" }
            }
            steps {
                script {
                    echo "Testing Windows XP compatibility patch against latest upstream ${BRANCH}..."
                    sh "./ci/scripts/auto-patch.sh ${BRANCH} xp-compat-v0.5.5.patch"

                    def patchFile = "${WORKSPACE}/xp-compat-${BRANCH}.patch"
                    if (!fileExists(patchFile)) {
                        patchFile = "${WORKSPACE}/xp-compat-v0.5.5.patch"
                    }
                    env.RESOLVED_PATCH = patchFile
                    echo "Using verified patch: ${env.RESOLVED_PATCH}"
                }
            }
        }

        stage('Build OpenRCT2 Nightly') {
            when {
                expression { return env.SKIP_BUILD != "true" }
            }
            steps {
                echo "Compiling OpenRCT2 ${BRANCH} (${env.SHORT_SHA}) with ${NUM_CORES} parallel cores..."
                sh """
                    make all \
                        OPENRCT2_VERSION=${BRANCH} \
                        PATCH_FILE="${env.RESOLVED_PATCH}" \
                        CMAKE_BUILD_TYPE=${BUILD_TYPE} \
                        CPU_CORES=${NUM_CORES}
                """
            }
        }

        stage('Windows XP Compatibility Verification') {
            when {
                expression { return env.SKIP_BUILD != "true" }
            }
            steps {
                echo "Scanning generated nightly binaries for Windows Vista+ API violations..."
                sh """
                    make check \
                        OPENRCT2_VERSION=${BRANCH} \
                        PATCH_FILE="${env.RESOLVED_PATCH}"
                """
            }
        }

        stage('Package Nightly Release') {
            when {
                expression { return env.SKIP_BUILD != "true" }
            }
            steps {
                echo "Packaging nightly portable zip: ${env.NIGHTLY_PACKAGE}..."
                sh """
                    make package \
                        OPENRCT2_VERSION=${BRANCH} \
                        PATCH_FILE="${env.RESOLVED_PATCH}" \
                        PACKAGE_NAME="${env.NIGHTLY_PACKAGE}"
                """
                echo "Verifying mandatory TLS certificate store (cacert.pem)..."
                sh """
                    if unzip -l "${env.NIGHTLY_PACKAGE}" | grep -q "cacert.pem"; then
                        echo "[PASS] cacert.pem verified inside nightly package!"
                    else
                        echo "[FAIL] FATAL ERROR: cacert.pem is missing from the nightly package!" >&2
                        exit 1
                    fi
                """
            }
        }

        stage('Publish Nightly to GitHub') {
            when {
                expression { return env.SKIP_BUILD != "true" && params.PUBLISH_TO_GITHUB == true }
            }
            steps {
                script {
                    echo "Preparing GitHub Pre-Release for Nightly ${env.SHORT_SHA} on ${GITHUB_REPO}..."
                    try {
                        withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                            sh """
                                TAG="nightly-${BUILD_DATE}-${env.SHORT_SHA}"
                                ZIP_FILE="${env.NIGHTLY_PACKAGE}"
                                if [ ! -f "\${ZIP_FILE}" ]; then
                                    echo "Error: Nightly package \${ZIP_FILE} not found." >&2
                                    exit 1
                                fi
                                echo "Release artifact: \${ZIP_FILE}"
                                echo "Publishing as GitHub pre-release with tag: \${TAG}..."

                                if gh release view "\${TAG}" --repo "${GITHUB_REPO}" >/dev/null 2>&1; then
                                    echo "Updating existing release \${TAG}..."
                                    gh release upload "\${TAG}" "\${ZIP_FILE}" --repo "${GITHUB_REPO}" --clobber
                                else
                                    echo "Creating new GitHub pre-release for \${TAG}..."
                                    gh release create "\${TAG}" "\${ZIP_FILE}" \
                                        --repo "${GITHUB_REPO}" \
                                        --title "OpenRCT2 Windows XP Nightly (${BUILD_DATE} - ${env.SHORT_SHA})" \
                                        --notes "Automated nightly development build of OpenRCT2 for Windows XP compiled from upstream develop commit ${env.UPSTREAM_SHA}. Includes TLS 1.2 support and pre-bundled cacert.pem." \
                                        --prerelease
                                fi
                                echo "GitHub nightly pre-release published successfully!"
                            """
                        }
                    } catch (Exception e) {
                        echo "Notice: Could not publish nightly to GitHub: ${e.getMessage()}"
                        echo "Ensure a Secret text credential named 'github-token' exists in Jenkins."
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.SKIP_BUILD != "true") {
                    echo "Nightly dev build completed and passed XP compatibility verification!"
                    writeFile file: ".last_built_develop_sha", text: env.UPSTREAM_SHA
                    archiveArtifacts artifacts: 'OpenRCT2-winxp-nightly*.zip, OpenRCT2/_build/openrct2.exe, OpenRCT2/_build/openrct2-cli.exe, OpenRCT2/_build/openrct2.com', fingerprint: true, allowEmptyArchive: true
                } else {
                    echo "Build successfully skipped: Upstream OpenRCT2 is already up-to-date."
                }
            }
        }
        failure {
            echo "Nightly build or compatibility check failed. Please inspect console logs."
        }
    }
}
